    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"cv_quality\": { \"type\": \"string\", \"enum\": [\"ok\", \"unreadable\"] },\n    \"verdicts\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\":        { \"type\": \"string\" },\n          \"verdict\":   { \"type\": \"string\", \"enum\": [\"met\", \"partial\", \"not_met\"] },\n          \"evidence\":  { \"type\": [\"string\", \"null\"] },\n          \"reasoning\": { \"type\": \"string\" }\n        },\n        \"required\": [\"id\", \"verdict\", \"evidence\", \"reasoning\"],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\"cv_quality\", \"verdicts\"],\n  \"additionalProperties\": false\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1520,
        176
      ],
      "id": "e564a75a-fa3c-4b18-9bb9-782b80898348",
      "name": "Verdict Parser"
    },
    {
      "parameters": {
        "jsCode": "// Turn per-criterion verdicts into a BUCKET (deterministic, reproducible).\n// The LLM never emits the bucket — this node does, so policy lives in one place.\n// Buckets: Strong / Possible / Unlikely / NeedsReview.\n// A number (coverage) is computed for internal sorting but is NOT the headline.\nconst POINTS = { met: 1, partial: 0.5, not_met: 0 };\nconst round2 = x => Math.round(x * 100) / 100;\nconst out = [];\n\nfor (const item of $input.all()) {\n  const d = item.json || {};\n  const criteria = d.criteria || {};\n  const core = Array.isArray(criteria.core_requirements) ? criteria.core_requirements : [];\n  const pref = Array.isArray(criteria.preferred) ? criteria.preferred : [];\n  const verdicts = Array.isArray(d.verdicts) ? d.verdicts : [];\n  const cvQuality = d.cv_quality || 'ok';\n\n  const byId = {};\n  for (const v of verdicts) if (v && v.id) byId[v.id] = v;\n\n  function cov(list) {\n    let num = 0, den = 0, miss = 0;\n    for (const c of list) {\n      const w = Number(c.weight) > 0 ? Number(c.weight) : 1;\n      const vv = (byId[c.id] || {}).verdict || 'not_met';\n      num += (POINTS[vv] ?? 0) * w;\n      den += w;\n      if (vv === 'not_met') miss += 1;\n    }\n    return { score: den ? num / den : 0, miss };\n  }\n\n  const c = cov(core);\n  const p = cov(pref);\n\n  // ---- bucket policy (tunable) ----\n  let bucket, reason;\n  if (cvQuality === 'unreadable' || core.length === 0) {\n    bucket = 'NeedsReview';\n    reason = core.length === 0 ? 'No criteria extracted from JD.' : 'CV text unreadable or not a resume.';\n  } else if (c.miss === 0 && c.score >= 0.8) {\n    bucket = 'Strong';\n  } else if (c.miss <= 1 && c.score >= 0.5) {\n    bucket = 'Possible';   // lenient: one missing core still allows Possible\n  } else {\n    bucket = 'Unlikely';\n  }\n\n  // ---- human-readable reason from met/missing core ----\n  if (!reason) {\n    const missCore = [];\n    for (const cc of core) {\n      const vv = (byId[cc.id] || {}).verdict || 'not_met';\n      if (vv === 'not_met') missCore.push(cc.requirement);\n    }\n    const parts = [`${core.length - c.miss}/${core.length} core requirements addressed`];\n    if (missCore.length) parts.push('missing: ' + missCore.slice(0, 4).join('; '));\n    reason = parts.join(' — ');\n  }\n\n  // ---- full auditable breakdown ----\n  const breakdown = [];\n  for (const cc of core) {\n    const vv = byId[cc.id] || {};\n    breakdown.push({ type: 'core', id: cc.id, requirement: cc.requirement, weight: cc.weight, verdict: vv.verdict || 'not_met', evidence: vv.evidence || null, reasoning: vv.reasoning || null });\n  }\n  for (const cc of pref) {\n    const vv = byId[cc.id] || {};\n    breakdown.push({ type: 'preferred', id: cc.id, requirement: cc.requirement, weight: cc.weight, verdict: vv.verdict || 'not_met', evidence: vv.evidence || null, reasoning: vv.reasoning || null });\n  }\n\n  out.push({ json: {\n    job_title: d.job_title || '',\n    source_file: d.source_file || '',\n    bucket,\n    reason,\n    core_total: core.length,\n    core_met: core.length - c.miss,\n    core_missing: c.miss,\n    coverage_internal: round2(c.score),\n    breakdown_json: JSON.stringify(breakdown),\n    criteria_json: JSON.stringify(criteria)\n  } });\n}\n\nreturn out;"
      },

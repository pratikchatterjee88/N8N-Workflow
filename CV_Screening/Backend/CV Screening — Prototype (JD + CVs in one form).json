    {
      "parameters": {
        "jsCode": "// Fan out: emit one item per uploaded CV, carrying the criteria + the file binary.\n// Iterates ALL binary keys so it does not depend on how the request names them.\nconst criteria = $json.output || {};\nconst req = $('Webhook').first();\nconst bin = req.binary || {};\nconst body = req.json.body || {};\nconst jobTitle = body['Job Title'] || '';\nconst keys = Object.keys(bin);\nconst out = [];\nfor (const k of keys) {\n  const b = bin[k];\n  const name = b.fileName || k;\n  out.push({\n    json: {\n      criteria,\n      job_title: jobTitle,\n      source_file: name,\n      file_ext: (name.split('.').pop() || '').toLowerCase()\n    },\n    binary: { data: b }\n  });\n}\nreturn out;"
      },

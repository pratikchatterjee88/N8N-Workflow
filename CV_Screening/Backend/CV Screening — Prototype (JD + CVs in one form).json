        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"core_requirements\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\":          { \"type\": \"string\" },\n          \"requirement\": { \"type\": \"string\" },\n          \"weight\":      { \"type\": \"number\" }\n        },\n        \"required\": [\"id\", \"requirement\", \"weight\"],\n        \"additionalProperties\": false\n      }\n    },\n    \"preferred\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\":          { \"type\": \"string\" },\n          \"requirement\": { \"type\": \"string\" },\n          \"weight\":      { \"type\": \"number\" }\n        },\n        \"required\": [\"id\", \"requirement\", \"weight\"],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\"core_requirements\", \"preferred\"],\n  \"additionalProperties\": false\n}"
